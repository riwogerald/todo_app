<div class="container-fluid mt-4">
  <!-- Header Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="display-5 fw-bold text-primary mb-1">Task MasterList</h1>
          <p class="text-muted mb-0">Organize your tasks efficiently with priorities and deadlines</p>
        </div>
        <%= link_to new_task_path, class: "btn btn-primary btn-lg shadow-sm" do %>
          <i class="bi bi-plus-circle me-2"></i>New Task
        <% end %>
      </div>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="row mb-4">
    <div class="col-md-2 col-sm-4 col-6 mb-3">
      <div class="card bg-primary text-white h-100">
        <div class="card-body text-center">
          <i class="bi bi-list-task display-6 mb-2"></i>
          <h4 class="card-title"><%= @task_stats[:total] %></h4>
          <p class="card-text small">Total Tasks</p>
        </div>
      </div>
    </div>
    <div class="col-md-2 col-sm-4 col-6 mb-3">
      <div class="card bg-success text-white h-100">
        <div class="card-body text-center">
          <i class="bi bi-check-circle display-6 mb-2"></i>
          <h4 class="card-title"><%= @task_stats[:completed] %></h4>
          <p class="card-text small">Completed</p>
        </div>
      </div>
    </div>
    <div class="col-md-2 col-sm-4 col-6 mb-3">
      <div class="card bg-warning text-dark h-100">
        <div class="card-body text-center">
          <i class="bi bi-clock display-6 mb-2"></i>
          <h4 class="card-title"><%= @task_stats[:pending] %></h4>
          <p class="card-text small">Pending</p>
        </div>
      </div>
    </div>
    <div class="col-md-2 col-sm-4 col-6 mb-3">
      <div class="card bg-danger text-white h-100">
        <div class="card-body text-center">
          <i class="bi bi-exclamation-triangle display-6 mb-2"></i>
          <h4 class="card-title"><%= @task_stats[:overdue] %></h4>
          <p class="card-text small">Overdue</p>
        </div>
      </div>
    </div>
    <div class="col-md-2 col-sm-4 col-6 mb-3">
      <div class="card bg-info text-white h-100">
        <div class="card-body text-center">
          <i class="bi bi-calendar-day display-6 mb-2"></i>
          <h4 class="card-title"><%= @task_stats[:due_today] %></h4>
          <p class="card-text small">Due Today</p>
        </div>
      </div>
    </div>
    <div class="col-md-2 col-sm-4 col-6 mb-3">
      <div class="card bg-secondary text-white h-100">
        <div class="card-body text-center">
          <i class="bi bi-percent display-6 mb-2"></i>
          <h4 class="card-title"><%= @task_stats[:total] > 0 ? (@task_stats[:completed].to_f / @task_stats[:total] * 100).round : 0 %>%</h4>
          <p class="card-text small">Complete</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Search and Filters -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <%= form_with url: tasks_path, method: :get, local: true, class: "row g-3" do |form| %>
            <div class="col-md-4">
              <%= form.text_field :search, placeholder: "Search tasks...", 
                  value: params[:search], class: "form-control",
                  data: { turbo_method: "get" } %>
            </div>
            <div class="col-md-2">
              <%= form.select :category, 
                  options_for_select([['All Categories', 'all']] + Task::CATEGORIES.map { |c| [c, c] }, params[:category]), 
                  {}, { class: "form-select", onchange: "this.form.submit();" } %>
            </div>
            <div class="col-md-2">
              <%= form.select :status, 
                  options_for_select([
                    ['All Status', ''],
                    ['Pending', 'pending'],
                    ['Completed', 'completed'],
                    ['Overdue', 'overdue'],
                    ['Due Today', 'due_today']
                  ], params[:status]), 
                  {}, { class: "form-select", onchange: "this.form.submit();" } %>
            </div>
            <div class="col-md-2">
              <%= form.select :sort, 
                  options_for_select([
                    ['Latest First', ''],
                    ['Priority', 'priority'],
                    ['Due Date', 'due_date'],
                    ['Category', 'category']
                  ], params[:sort]), 
                  {}, { class: "form-select", onchange: "this.form.submit();" } %>
            </div>
            <div class="col-md-2">
              <%= form.submit "Search", class: "btn btn-outline-primary" %>
              <% if params[:search].present? || params[:category].present? || params[:status].present? %>
                <%= link_to "Clear", tasks_path, class: "btn btn-outline-secondary ms-1" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Tasks List -->
  <div class="row">
    <div class="col-12">
      <% if @tasks.any? %>
        <div class="row">
          <% @tasks.each do |task| %>
            <div class="col-lg-4 col-md-6 mb-4">
              <div class="card h-100 shadow-sm task-card <%= 'border-success' if task.completed %> <%= 'border-danger' if task.overdue? %>">
                <!-- Card Header with Priority -->
                <div class="card-header d-flex justify-content-between align-items-center <%= 'bg-success text-white' if task.completed %>">
                  <div class="d-flex align-items-center">
                    <i class="bi bi-<%= task.priority_icon %> text-<%= task.priority_color %> me-2"></i>
                    <small class="fw-bold"><%= task.priority_label %></small>
                  </div>
                  <span class="badge bg-<%= task.category == 'Work' ? 'primary' : task.category == 'Personal' ? 'info' : 'secondary' %>"><%= task.category %></span>
                </div>
                
                <!-- Card Body -->
                <div class="card-body">
                  <h5 class="card-title <%= 'text-decoration-line-through text-muted' if task.completed %>">
                    <%= link_to task.title, task_path(task), class: "text-decoration-none #{'text-muted' if task.completed}" %>
                  </h5>
                  
                  <% if task.description.present? %>
                    <p class="card-text text-muted small"><%= truncate(task.description, length: 100) %></p>
                  <% end %>
                  
                  <!-- Status and Due Date -->
                  <div class="mb-3">
                    <% if task.completed %>
                      <span class="badge bg-success rounded-pill">
                        <i class="bi bi-check-circle me-1"></i>Completed
                      </span>
                    <% elsif task.overdue? %>
                      <span class="badge bg-danger rounded-pill">
                        <i class="bi bi-exclamation-triangle me-1"></i>Overdue
                      </span>
                    <% elsif task.due_today? %>
                      <span class="badge bg-warning text-dark rounded-pill">
                        <i class="bi bi-calendar-day me-1"></i>Due Today
                      </span>
                    <% else %>
                      <span class="badge bg-secondary rounded-pill">
                        <i class="bi bi-clock me-1"></i>Pending
                      </span>
                    <% end %>
                    
                    <% if task.due_date.present? %>
                      <div class="mt-2 small text-muted">
                        <i class="bi bi-calendar3 me-1"></i><%= task.formatted_due_date %>
                      </div>
                    <% end %>
                  </div>
                  
                  <!-- Progress Bar (for tasks with due dates) -->
                  <% if task.due_date.present? && !task.completed? %>
                    <div class="progress mb-2" style="height: 4px;">
                      <div class="progress-bar <%= task.overdue? ? 'bg-danger' : 'bg-primary' %>" 
                           style="width: <%= [task.progress_percentage, 100].min %>%"></div>
                    </div>
                  <% end %>
                </div>
                
                <!-- Card Footer with Actions -->
                <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                  <small class="text-muted">
                    <i class="bi bi-calendar-plus me-1"></i>
                    <%= time_ago_in_words(task.created_at) %> ago
                  </small>
                  <div class="btn-group" role="group">
                    <%= link_to edit_task_path(task), class: "btn btn-outline-primary btn-sm", title: "Edit" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to task_path(task), method: :delete, 
                        data: { 
                          confirm: "Are you sure?",
                          turbo_method: :delete
                        }, 
                        class: "btn btn-outline-danger btn-sm", title: "Delete" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-5">
          <div class="mb-4">
            <% if params[:search].present? || params[:category].present? || params[:status].present? %>
              <i class="bi bi-search display-1 text-muted"></i>
              <h3 class="text-muted mb-3 mt-3">No tasks found</h3>
              <p class="text-muted mb-4">Try adjusting your search or filters</p>
              <%= link_to "Clear Filters", tasks_path, class: "btn btn-outline-primary" %>
            <% else %>
              <i class="bi bi-clipboard-check display-1 text-muted"></i>
              <h3 class="text-muted mb-3 mt-3">No tasks yet</h3>
              <p class="text-muted mb-4">Get started by creating your first task!</p>
              <%= link_to "Create Your First Task", new_task_path, class: "btn btn-primary btn-lg" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
